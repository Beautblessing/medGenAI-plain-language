# Optional paths. Defaults are local folders named runtime*, which are gitignored.
CLINICAL_REVIEW_RUNTIME=runtime
CLINICAL_EVAL_RUNTIME=runtime_eval
CLINICAL_NARRATIVE_REVIEW_RUNTIME=runtime_narrative_review

# Keep the application offline after model setup.
HF_HUB_OFFLINE=1

# Optional evaluation features hidden in the submitted scope.
CLINICAL_EVAL_ENABLE_ANONYMIZATION=0
CLINICAL_EVAL_ENABLE_SUMMARIZATION=0
